{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mica",
  "scopeName": "source.mica",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#blocks"
    },
    {
      "include": "#references"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mica",
          "match": "(//|#).*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mica",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mica",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.mica",
      "match": "\\b-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
    },
    "booleans": {
      "name": "constant.language.boolean.mica",
      "match": "\\b(true|false|null)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.math.mica",
          "match": "(\\+|\\-|\\*|\\/|\\%)"
        },
        {
          "name": "keyword.operator.assignment.mica",
          "match": "="
        }
      ]
    },
    "properties": {
      "name": "meta.property.mica",
      "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=|:)",
      "captures": {
        "1": {
          "name": "variable.other.property.mica"
        },
        "2": {
          "name": "keyword.operator.assignment.mica"
        }
      }
    },
    "blocks": {
      "name": "meta.block.mica",
      "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\{)",
      "captures": {
        "1": {
          "name": "entity.name.section.mica"
        },
        "2": {
          "name": "punctuation.section.block.begin.mica"
        }
      }
    },
    "references": {
      "name": "variable.parameter.mica",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)+)\\b"
    }
  }
}